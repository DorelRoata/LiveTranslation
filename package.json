{
  "name": "live-translator",
  "version": "1.3.24",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-mediapipe-assets.js && vite",
    "build": "node scripts/prepare-mediapipe-assets.js && vite build && node scripts/runtime-state.js mark-build",
    "postinstall": "node scripts/runtime-state.js mark-dependencies",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "start": "node server.js",
    "start:app": "npm run build && npm start"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@mediapipe/tasks-audio": "^1.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
